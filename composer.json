{
    "name": "3neti/x-document-laravel",
    "description": "Laravel HTTP delivery adapter for portable x-document representations",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Lester Hurtado",
            "email": "lester@hurtado.ph"
        }
    ],
    "require": {
        "php": "^8.4",
        "3neti/x-document": "dev-main",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/http-foundation": "^7.2|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.7",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "LBHurtado\\XDocumentLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBHurtado\\XDocumentLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LBHurtado\\XDocumentLaravel\\XDocumentLaravelServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../x-document",
            "options": {
                "symlink": false
            }
        }
    ],
    "scripts": {
        "test": "pest --compact",
        "analyse": "phpstan analyse --no-progress",
        "format": "pint --format agent"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
